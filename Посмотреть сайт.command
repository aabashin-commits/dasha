#!/bin/zsh
# Двойной клик по этому файлу открывает сайт в браузере.
#
# Зачем нужен: страницы ссылаются друг на друга абсолютными путями
# (/works/, /assets/style.css) — так правильно для настоящего хостинга,
# но при открытии файла напрямую с диска такие ссылки не работают.
# Скрипт поднимает маленький локальный сервер и решает это.
#
# Чтобы закрыть — закройте окно Терминала или нажмите Ctrl+C.

cd "$(dirname "$0")" || exit 1

PORT=4321

echo ""
echo "  Keyframe — локальный просмотр"
echo "  http://localhost:$PORT"
echo ""
echo "  Правьте HTML и обновляйте страницу в браузере."
echo "  Чтобы закрыть — Ctrl+C или закройте это окно."
echo ""

# Даём серверу мгновение подняться, потом открываем браузер
( sleep 1; open "http://localhost:$PORT" ) &

python3 -m http.server $PORT --bind 127.0.0.1
